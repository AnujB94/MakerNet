# Copy to .env.local for the web app, or export these before starting the web process.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://makernet:makernet@127.0.0.1:5432/makernet
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=local-access
OBJECT_STORAGE_SECRET_KEY=local-secret
SMTP_URL=smtp://127.0.0.1:1025
APP_VERSION=0.1.0-dev
BUILD_COMMIT=local
